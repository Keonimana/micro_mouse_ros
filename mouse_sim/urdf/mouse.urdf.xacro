<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="micro_mouse">

    <!-- Reference Frame -->
    <link name="base_footprint"/>

    <!-- Chassis Frame -->
    <link name="base_link">
        <!-- Visual Representation in Sim -->
        <visual>
            <origin xyz="0 0 0.0125" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.06 0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 0.8"/>
            </material>
        </visual>

        <!-- Collision Boundaries -->
        <collision>
            <origin xyz="0 0 0.0125" rpy="0 0 0"/>
            <geometry>
                <box size="0.10 0.06 0.04"/> <!-- Should be same as visual -->
            </geometry>
        </collision>

        <!-- Mass and Inertial Behavior -->
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
    </link>

    <!-- Connection Between Base-link and Base-footprint-->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <!-- Wheel Link Template -->
    <xacro:macro name="wheel" params="position x_reflect y_reflect">
        <!-- Link -->
        <link name="${position}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="0.01" length="0.0125"/>
                </geometry>
                <material name="grey">
                    <color rgba="0.663 0.533 0.6 0.8"/>
                </material>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="0.01" length="0.0125"/>
                </geometry>
            </collision>

            <inertial>
                <mass value="0.02"/>
                <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
            </inertial>
        </link>

        <!-- Joint -->
        <joint name="${position}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${position}_wheel"/>
            <origin xyz="${x_reflect * 0.025} ${y_reflect * 0.03625} 0" rpy="-1.5708 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>

    <!-- Wheels (Links + Joints)-->
    <xacro:wheel position="front_left"  x_reflect="1"  y_reflect="1" />
    <xacro:wheel position="front_right" x_reflect="1"  y_reflect="-1" />
    <xacro:wheel position="rear_left"   x_reflect="-1" y_reflect="1" />
    <xacro:wheel position="rear_right"  x_reflect="-1" y_reflect="-1" />

    <!-- Gazebo Simulation Logic -->
    <gazebo>
        <!-- Enable Differential Drive -->
        <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
            <!-- Wheel Joints -->
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>

            <!-- Kinematics -->
            <wheel_separation>0.0725</wheel_separation>
            <wheel_radius>0.01</wheel_radius>

            <!-- Limits -->
            <max_linear_acceleration>1.0</max_linear_acceleration>

            <!-- Topic & Frames -->
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>
    </gazebo>

    <!-- File Inclusions -->
    <xacro:include filename="lidar.xacro" /> <!-- Includes Lidar Capabilities -->

</robot>