<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Visual Laser Indicator -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.015" length="0.01"/>
            </geometry>
            <material name="grey">
                <color rgba="0.663 0.533 0.6 0.8"/>
            </material>
        </visual>
    </link>

    <link name="laser_visualizer">
        <visual>
            <geometry>
                <cylinder radius="0.0005" length="0.05"/>
            </geometry>
            <material name="magenta">
                <color rgba="0.197 0 0.47 0.8"/>
            </material>
        </visual>
    </link>

    <!-- Laser Location -->
    <joint name="laser_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_frame"/>
        <origin xyz="-0.03 0 0.0375" rpy="0 0 0"/>
    </joint>

    <joint name="laser_visualizer_joint" type="fixed">
        <parent link="laser_frame"/>
        <child link="laser_visualizer"/>
        <origin xyz="0.025 0 0.005" rpy="0 1.5708 0"/>
    </joint>

    <!-- Enable Gazebo Interaction -->
    <gazebo reference="laser_frame">
        <material name="magenta">
            <color rgba="0.197 0 0.47 0.8"/>
        </material>

        <sensor name="gpu_lidar" type="gpu_lidar">
            <pose relative-to="laser_frame"> 0 0 0 0 0 0 </pose>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <always_on>1</always_on>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.02</min>
                    <max>2.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>
    </gazebo>

</robot>